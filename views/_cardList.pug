//- card list of a group (library or official). needs: cards, cardsBase (/anki/library/:id or /anki/official/:id)
.panel-toolbar
  .search-box
    i.fa-solid.fa-magnifying-glass
    input#card-search(type='search' placeholder='ابحث في البطاقات' aria-label='ابحث في البطاقات')
  a.btn.btn-primary.add-card-btn(href=`${cardsBase}/add-card`)
    i.fa-solid.fa-plus
    |  إضافة بطاقة

ul.card-list#card-list(hidden=!cards.length)
  each card, i in cards
    - const search = [card.front, card.back, card.text, card.extra].filter(Boolean).join(' ')
    li.card-item(data-card-id=card._id data-type=card.type data-search=search)
      span.card-index= i + 1
      .card-item-body
        +typeBadge(card.type, card.type === 'reverse' ? ' · بطاقتان' : '')
        if card.type === 'basic' || card.type === 'reverse'
          p.q= card.front
          p.a
            i.fa-solid.fa-reply
            | #{card.back}
        else if card.type === 'cloze'
          p.q!= clozeHtml(card.text)
        else
          .thumb-wrap
            img(src=card.image alt='' loading='lazy')
            each m in card.masks
              span.mask(style=`left:${m.x}%;top:${m.y}%;width:${m.w}%;height:${m.h}%`)
          p.a #{card.masks.length} منطقة مخفية
      .card-item-actions
        a.icon-btn(href=`${cardsBase}/cards/${card._id}/edit` title='تعديل' aria-label='تعديل البطاقة')
          i.fa-solid.fa-pen
        button.icon-btn.danger.delete-card-btn(type='button' title='حذف' aria-label='حذف البطاقة')
          i.fa-solid.fa-trash
p.no-results(hidden) لا توجد بطاقات مطابقة

.cards-empty(hidden=!!cards.length)
  +emptyState('fa-clone', 'لا توجد بطاقات بعد', 'أضف بطاقات بسيطة أو عكسية أو فراغات أو صور')
    a.btn.btn-primary(href=`${cardsBase}/add-card`)
      i.fa-solid.fa-plus
      |  إضافة بطاقة
