extends _adminForm

block vars
  - var pageTitle = 'تعديل سؤال'
  - var pageIcon = 'fa-circle-question'
  - var pageSub = ''
  - var pageScript = 'editQuestion'
  - var bodyData = {}

block form
    .container
      .form
        .field
          label(for='question') السؤال
          input#question.input-question(type='text', value=question.text)
        .field
          label(for='answer-1') الخيار الأول
          input#answer-1.input(type='text', value=question.answers[0])
        .field
          label(for='answer-2') الخيار الثاني
          input#answer-2.input(type='text', value=question.answers[1])
        .field
          label(for='answer-3') الخيار الثالث
          input#answer-3.input(type='text', value=question.answers[2])
        .field
          label(for='answer-4') الخيار الرابع
          input#answer-4.input(type='text', value=question.answers[3])
        .field
          label(for='correct-answer') الإجابة الصحيحة
          input#correct-answer.input(type='number', value=question.correctAnswer)
        button.btn-sub.upload-questions-btn(type='button') حفظ التعديلات
