doctype html
html(lang="ar" dir="rtl")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title فيديوهات الشرح

    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css")
    link(rel="stylesheet" href="/css/video.css")
  - const domain = process.env.DOMAIN_ACTIVE === 'local'? process.env.DOMAIN_LOCAL : process.env.DOMAIN_RENDER;
  - const achievedLesson = 1;
  body(data-domain=domain)
    // ================= NAVBAR =================
    header.navbar
      .logo
        i.fa-solid.fa-graduation-cap
        span Studyou - د/ إياد سكر

      .navbar-left
        button.mobile-toggle-btn#openSidebar
          i.fa-solid.fa-bars

        .student-info
          .student-avatar أ
          div
            strong= user.name
            small= `${user.role === 'admin'? "أدمن": "طالب"}`

    // ================= MAIN =================
    main.main-container

      // ================= SIDEBAR =================
      aside.sidebar#sidebar
        .sidebar-header
          div
            span.course-label الكورس
            h2= course.title

          button.close-sidebar#closeSidebar
            i.fa-solid.fa-xmark

        // Progress
        .course-progress
          .progress-top
            span
              i.fa-solid.fa-book-open
              | تقدمك في الكورس
            strong= `${Math.ceil((achievedLesson/lessons.length) * 100)}%`

          .progress
            span(style=`width: ${Math.ceil((achievedLesson/lessons.length) * 100)}%`)

          small= `${achievedLesson} من ${lessons.length} درس مكتمل`

        // Lessons
        .lessons-list
          each lesson in lessons
            .lesson.active.open
              .lesson-header
                .lesson-number 01

                .lesson-title
                  h3= lesson.title
                  span= lesson.subtitle

                i.fa-solid.fa-chevron-down.arrow

              .lesson-content
                each video in lesson.videos
                  - if(video.fileType === 'video')
                    // VIDEO
                    button.lesson-resource.video-resource
                      span.resource-icon.video
                        i.fa-solid.fa-play
                      span.resource-info
                        strong= video.title
                        small= video.duration
                      i.fa-solid.fa-circle-check.completed
                  - if(video.fileType === 'pdf')
                    // PDF
                    button.lesson-resource
                      span.resource-icon.pdf
                        i.fa-solid.fa-file-pdf
                      span.resource-info
                        strong ملف PDF
                        small= video.title
                      i.fa-solid.fa-download.resource-action
                  - if(video.fileType === 'quiz')
                    // QUIZ
                    button.lesson-resource.quiz-resource(data-quiz="lesson1")
                      span.resource-icon.quiz
                        i.fa-solid.fa-clipboard-question
                      span.resource-info
                        strong= video.title
                        small= `${video.questions.length} أسألة`
                      i.fa-solid.fa-chevron-left.resource-action
                  
      // ================= CONTENT =================
      section.content-area

        // ================= VIDEO VIEW =================
        #videoView.page-view.active-view
          .video-container
            div(style="position:relative; height:100%; width:100%;")
              iframe.my-iframe(
                src="https://iframe.mediadelivery.net/embed/506218/4bfa97e9-adaf-4064-b91a-bb687db18d14?autoplay=true&loop=false&muted=true&preload=true&responsive=true"
                loading="lazy"
                style="border:0;border-radius:6px;position:absolute;top:0;height:100%;width:100%;"
                allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;"
                allowfullscreen="true"
              )

            //- .video-placeholder
              //- .play-big
                i.fa-solid.fa-play
              //- span فيديو المحاضرة الأولى

          .video-details-card
            .video-header-info
              div
                span.badge الدرس الأول
                h1 المحاضرة الأولى

              button.btn.btn-success
                i.fa-solid.fa-check
                | تم إكمال الدرس

            .video-meta
              span
                i.fa-regular.fa-clock
                | 20:22 دقيقة
              span
                i.fa-solid.fa-book
                | الوحدة الأولى

            hr.divider

            p.video-description
              | في هذه المحاضرة سنتعرف على الجهاز العصبي بقسميه
            .navigation-buttons
              //- button.btn.btn-secondary
              //-   i.fa-solid.fa-arrow-right
              //-   | الدرس السابق

              button.btn.btn-primary
                | حل الاختبار
                i.fa-solid.fa-arrow-left

        // ================= QUIZ VIEW =================
        #quizView.page-view
          .quiz-card
            .quiz-header
              div
                span.badge اختبار الدرس
                h1 اختبار العمليات على الأعداد
                p أجب عن جميع الأسئلة التالية

              .question-counter
                | السؤال
                strong#currentQuestion 1
                | من
                strong#totalQuestions 5

            .quiz-progress
              #quizProgressBar

            .question-box
              span.question-label السؤال
              h2#questionText كم يساوي 5 + 3 ؟

              .options-grid#optionsContainer

            .quiz-footer
              button.btn.btn-secondary#prevQuestion
                i.fa-solid.fa-arrow-right
                | السابق

              button.btn.btn-primary#nextQuestion
                | التالي
                i.fa-solid.fa-arrow-left

        // ================= LOADER =================
        #loadingView.page-view.loading-view
          .loader-card
            .loader
            h2 جاري تصحيح الاختبار
            p لحظات ويتم عرض نتيجتك...

        // ================= RESULT =================
        #resultView.page-view
          .result-card
            .result-icon
              i.fa-solid.fa-trophy

            span.result-label النتيجة النهائية
            h1 أحسنت!

            .score
              span#scorePercentage 80%

            p.result-message#resultMessage نتيجة رائعة، استمر بالتقدم!

            .result-stats
              .result-stat
                .stat-icon.correct
                  i.fa-solid.fa-check
                span الإجابات الصحيحة
                strong#correctAnswers 4

              .result-stat
                .stat-icon.wrong
                  i.fa-solid.fa-xmark
                span الإجابات الخاطئة
                strong#wrongAnswers 1

              .result-stat
                .stat-icon.total
                  i.fa-solid.fa-list
                span مجموع الأسئلة
                strong#resultTotal 5

            .result-actions
              button.btn.btn-primary#retryQuiz
                i.fa-solid.fa-rotate-right
                | إعادة الاختبار

              button.btn.btn-secondary#backToLesson
                i.fa-solid.fa-arrow-right
                | العودة إلى الدرس

    // Overlay
    .sidebar-overlay#sidebarOverlay

    script(src="/js/video.js")

