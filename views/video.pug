doctype html
html(lang="ar" dir="rtl")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title فيديوهات الشرح
    
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css")
    link(rel="stylesheet" href="/css/video.css")
    <link rel="icon" type="image/png" href="/my-favicon/favicon-96x96.png?v=20260916" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/my-favicon/favicon.svg?v=20260916" />
    <link rel="shortcut icon" href="/my-favicon/favicon.ico?v=20260916" />
    <link rel="apple-touch-icon" sizes="180x180" href="/my-favicon/apple-touch-icon.png?v=20260916" />
    <meta name="apple-mobile-web-app-title" content="Studyou" />
    <link rel="manifest" href="/my-favicon/site.webmanifest?v=20260916" />
  - const domain = process.env.DOMAIN_ACTIVE === 'local'? process.env.DOMAIN_LOCAL : process.env.DOMAIN_RENDER;
  - const totalVideos = lessons.reduce((sum,lesson) => { return sum + lesson.videos.length;}, 0);
  - const achievedLesson = courseProgress.achievedVideos.lessonNum;
  - const achievedRes = courseProgress.achievedVideos.videoNumber;
  - const toRes = resNum && lessonNum && (lessonNum < achievedLesson || (lessonNum == achievedLesson && resNum < achievedRes))? true: false;
  body(data-domain=domain, data-achieved-resource= achievedRes, data-achieved-lesson= achievedLesson data-to-res= toRes? '1':null)
    // ================= NAVBAR =================
    header.navbar
      .logo
        i.fa-solid.fa-graduation-cap
        span Studyou - د/ إياد سكر

      .navbar-left
        label.toggle
          input#dark-toggle(type='checkbox')
          span.slider
        .student-info
          .student-avatar= user.name[0]
          div
            strong= user.name
        button.mobile-toggle-btn#openSidebar
          i.fa-solid.fa-bars

    // ================= MAIN =================
    main.main-container

      // ================= SIDEBAR =================
      aside.sidebar#sidebar
        .sidebar-header
          div
            span.course-label الكورس
            h2= course.title

          button.close-sidebar#closeSidebar
            i.fa-solid.fa-xmark

        // Progress
        .course-progress(data-total-videos=totalVideos)
          .progress-top
            span
              i.fa-solid.fa-book-open
              | تقدمك في الكورس
            .progress-percentage(style="color: var(--accent);")= `${Math.ceil((courseProgress.achievedVideos.achievedVideosCount/totalVideos) * 100)}%`

          .progress
            span(style=`width: ${Math.ceil((courseProgress.achievedVideos.achievedVideosCount/totalVideos) * 100)}%`)

          small.progress-sentence= `${courseProgress.achievedVideos.achievedVideosCount} من ${totalVideos} درس مكتمل`

        // Lessons
        .lessons-list
          each lesson, i in lessons
            .lesson.open(data-lesson-id= lesson._id.toString() data-num= lesson.num class=[toRes && i + 1 == lessonNum? 'active':""])
              .lesson-header
                .lesson-number= lesson.num > 9? lesson.num + '.': `0` + lesson.num + "."

                .lesson-title
                  h3= lesson.title
                  span= lesson.subtitle

                i.fa-solid.fa-chevron-down.arrow

              .lesson-content
                each video, j in lesson.videos
                  button.lesson-resource(
                    class=[
                      video.fileType + "-resource",
                      achievedLesson < i + 1 || (achievedLesson == i + 1 && achievedRes < j)? "locked":"",
                      toRes && resNum == j && lessonNum == i + 1? "active":""
                    ]

                    data-quiz=(video.fileType === "quiz" ? "lesson1" : null)
                    data-video-url=(video.fileType === "video"? video.videoUrl : null)
                    data-num= video.num
                    data-badge=(video.fileType === "video"? lesson.title : null)
                    data-title=(video.fileType === "video"? video.title : null)
                    data-duration=(video.fileType === "video"? video.duration : null)
                    data-description=(video.fileType === "video"? video.info : null)
                  )
                    span.resource-icon(class=video.fileType)
                      if (achievedLesson < i + 1|| (achievedLesson == i + 1 && achievedRes < j))
                        i.fa-solid.fa-lock.resource-action
                      else if video.fileType === "video"
                        i.fa-solid.fa-play
                      else if video.fileType === "pdf"
                        i.fa-solid.fa-file-pdf
                      else if video.fileType === "quiz"
                        i.fa-solid.fa-clipboard-question

                    span.resource-info
                      strong= video.title
                      if video.fileType === "video"
                        small= video.duration
                      if video.fileType === "pdf"
                        small= video.title
                      if video.fileType === "quiz"
                        small= `${video.questions.length} أسألة`
                    i.state-mark.fa-solid(class=[achievedLesson < i + 1|| (achievedLesson == i + 1 && achievedRes <= j)? "fa-chevron-left resource-aciton" : "fa-circle-check completed"])
                    // Action icon
                    //- if video.fileType === "video"
                    //-   i.fa-solid
                    //- if video.fileType === "pdf"
                    //-   i.fa-solid.fa-download.resource-action
                    //- if video.fileType === "quiz"
                    //-   i.fa-solid.fa-chevron-left.resource-action

                  //- - if(video.fileType === 'video')
                  //-   // VIDEO
                  //-   button.lesson-resource.video-resource(class={active: video.num == 0})
                  //-     span.resource-icon.video
                  //-       i.fa-solid.fa-play
                  //-     span.resource-info
                  //-       strong= video.title
                  //-       small= video.duration
                  //-     i.fa-solid.fa-circle-check.completed
                  //- - if(video.fileType === 'pdf')
                  //-   // PDF
                  //-   button.lesson-resource
                  //-     span.resource-icon.pdf
                  //-       i.fa-solid.fa-file-pdf
                  //-     span.resource-info
                  //-       strong ملف PDF
                  //-       small= video.title
                  //-     i.fa-solid.fa-download.resource-action
                  //- - if(video.fileType === 'quiz')
                  //-   // QUIZ
                  //-   button.lesson-resource.quiz-resource(data-quiz="lesson1")
                  //-     span.resource-icon.quiz
                  //-       i.fa-solid.fa-clipboard-question
                  //-     span.resource-info
                  //-       strong= video.title
                  //-       small= `${video.questions.length} أسألة`
                  //-     i.fa-solid.fa-chevron-left.resource-action
                  
      // ================= CONTENT =================
      section.content-area

        // ================= VIDEO VIEW =================
        #videoView.page-view.active-view
          .video-container
            //- div(style="position:relative; height:100%; width:100%;")
              iframe.my-iframe(
                src="https://iframe.mediadelivery.net/embed/506218/4bfa97e9-adaf-4064-b91a-bb687db18d14?autoplay=false&loop=false&muted=true&preload=true&responsive=true"
                loading="lazy"
                style="border:0;border-radius:6px;position:absolute;top:0;height:100%;width:100%;"
                allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;"
                allowfullscreen="true"
              )

            //- .video-placeholder
              //- .play-big
                i.fa-solid.fa-play
              //- span فيديو المحاضرة الأولى

          .video-details-card
            .video-header-info
              div
                span.badge.video-badge الدرس الثاني
                h1.video-title المحاضرة الثانية
              
              button.btn.btn-success.hidden
                i.fa-solid.fa-check
                | تم إكمال الدرس

            .video-meta
              span.duration-container
                i.fa-regular.fa-clock
                | 20:23 دقيقة
              span
                i.fa-solid.fa-book
                | الوحدة الأولى

            hr.divider

            p.video-description
              | في هذه المحاضرة سنتعرف على الجهاز العصبي
            .navigation-buttons
              button.btn.btn-secondary#prevLesson(class=[achievedLesson == 1 && achievedRes == 0 ? "hidden": ""])
                i.fa-solid.fa-arrow-right
                | الدرس السابق

              button.btn.btn-primary#nextLesson
                | الدرس التالي
                i.fa-solid.fa-arrow-left

        // ================= QUIZ VIEW =================
        #quizView.page-view
          .quiz-card
            .quiz-header
              div
                span.badge اختبار الدرس
                h1.quiz-title
                p أجب عن جميع الأسئلة التالية

              .question-counter
                | السؤال
                strong#currentQuestion 1
                | من
                strong#totalQuestions 5

            .quiz-progress
              #quizProgressBar

            .question-box
              span.question-label السؤال
              h2#questionText كم يساوي 5 + 3 ؟

              .options-grid#optionsContainer

            .quiz-footer
              button.btn.btn-secondary#prevQuestion
                i.fa-solid.fa-arrow-right
                | السابق

              button.btn.btn-primary#nextQuestion
                | التالي
                i.fa-solid.fa-arrow-left

        // ================= LOADER =================
        #loadingView.page-view.loading-view
          .loader-card
            .loader
            h2.lodaer-title جاري تصحيح الاختبار
            p.loader-description لحظات ويتم عرض نتيجتك...

        // ================= RESULT =================
        #resultView.page-view
          .result-card
            .result-icon
              i.fa-solid.fa-trophy

            span.result-label النتيجة النهائية
            h1 أحسنت!

            .score
              span#scorePercentage 80%

            p.result-message#resultMessage نتيجة رائعة، استمر بالتقدم!

            .result-stats
              .result-stat
                .stat-icon.correct
                  i.fa-solid.fa-check
                span الإجابات الصحيحة
                strong#correctAnswers 4

              .result-stat
                .stat-icon.wrong
                  i.fa-solid.fa-xmark
                span الإجابات الخاطئة
                strong#wrongAnswers 1

              .result-stat
                .stat-icon.total
                  i.fa-solid.fa-list
                span مجموع الأسئلة
                strong#resultTotal 5

            .result-actions
              button.btn.btn-primary#retryQuiz
                i.fa-solid.fa-rotate-right
                | إعادة الاختبار

              button.btn.btn-secondary#backToLesson
                i.fa-solid.fa-arrow-right

    // Overlay
    .sidebar-overlay#sidebarOverlay

    script(src="/js/video.js")                