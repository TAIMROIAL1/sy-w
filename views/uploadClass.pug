extends _adminForm

block vars
  - var pageTitle = 'رفع صف'
  - var pageIcon = 'fa-school'
  - var pageSub = 'أضف صفا جديدا'
  - var pageScript = 'uploadClass'
  - var bodyData = {}

block form
    .container
      .form
        .field
          label(for='class-name') اسم الصف
          input#class-name.input(type='text')
        .field
          label(for='class-des') الوصف
          input#class-des.input(type='text')
        .field
          label(for='image') رابط الصورة
          input#image.input(type='text', dir='ltr')
        button.btn-sub(type='button') رفع
