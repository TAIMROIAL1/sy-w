doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  meta(name='theme-color' content='#432071')
  title &#x644;&#x648;&#x62D;&#x629; &#x627;&#x644;&#x62A;&#x62D;&#x643;&#x645; &#x627;&#x644;&#x62A;&#x639;&#x644;&#x64A;&#x645;&#x64A;&#x629;
  link(rel='stylesheet' href='/css/settings.css')
  <link rel="icon" type="image/png" href="/my-favicon/favicon-96x96.png?v=20260916" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/my-favicon/favicon.svg?v=20260916" />
  <link rel="shortcut icon" href="/my-favicon/favicon.ico?v=20260916" />
  <link rel="apple-touch-icon" sizes="180x180" href="/my-favicon/apple-touch-icon.png?v=20260916" />
  <meta name="apple-mobile-web-app-title" content="Studyou" />
  <link rel="manifest" href="/my-favicon/site.webmanifest?v=20260916" />
- const domain = process.env.DOMAIN_ACTIVE === 'local'? process.env.DOMAIN_LOCAL : process.env.DOMAIN_RENDER;
body(data-domain=domain)
  .layer.hidden
    .logout-container 
      p.logout-par ؟هل تريد تسجيل الخروج
      .logout-btns-container
        button.logout-btn.logout-accept= 'تاكيد'
        button.logout-btn.logout-cancel= 'الغاء'
  input#menu-toggle.menu-toggle(type='checkbox')
  .app-shell
    // طبقة الخلفية للموبايل
    label.sidebar-overlay(for='menu-toggle')
    // القائمة الرئيسية - أصبحت على اليسار
    aside.sidebar
      .sidebar-head
        span &#x627;&#x644;&#x642;&#x627;&#x626;&#x645;&#x629;
        label.close-menu(for='menu-toggle' aria-label='إغلاق القائمة') &times;
      nav.menu
        a.menu-item.active.item-number-1(role="button")
          span.menu-icon &#x2302;
          span &#x627;&#x644;&#x645;&#x639;&#x644;&#x648;&#x645;&#x627;&#x62A; &#x627;&#x644;&#x631;&#x626;&#x64A;&#x633;&#x64A;&#x629;
        a.menu-item.item-number-2(role="button")
          span.menu-icon &#x25A3;
          span &#x627;&#x644;&#x643;&#x648;&#x631;&#x633;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x641;&#x639;&#x644;&#x629;
        a.menu-item.item-number-3(role="button")
          span.menu-icon ?
          span &#x62A;&#x641;&#x639;&#x64A;&#x644; &#x627;&#x644;&#x623;&#x643;&#x648;&#x627;&#x62F;
        a.menu-item.logout-btn(role="button")
          span.menu-icon X
          span تسجيل الخروج
    .page
      .notifi.hidden
        .notifi-message
      // الهيدر
      header.topbar
        .profile
          .avatar= user.name[0]
          .profile-name= user.name
        .header-actions
          label.mobile-menu-button(for='menu-toggle' aria-label='فتح القائمة')
            span
            span
            span
          .notification
      main.content
        // المعلومات الشخصية
        section.card.info-card.section-1
          h2 &#x627;&#x644;&#x645;&#x639;&#x644;&#x648;&#x645;&#x627;&#x62A; &#x627;&#x644;&#x634;&#x62E;&#x635;&#x64A;&#x629;
          .info-grid
            .info-box
              .info-icon &#x2659;
              .info-text
                span.label &#x627;&#x644;&#x627;&#x633;&#x645; &#x627;&#x644;&#x643;&#x627;&#x645;&#x644;
                strong= user.name
            .info-box
              .info-icon &#x2709;
              .info-text
                span.label &#x627;&#x644;&#x628;&#x631;&#x64A;&#x62F; &#x627;&#x644;&#x625;&#x644;&#x643;&#x62A;&#x631;&#x648;&#x646;&#x64A;
                strong= user.email
            .info-box
              .info-icon &#x2667;
              .info-text
                span.label &#x646;&#x648;&#x639; &#x627;&#x644;&#x62D;&#x633;&#x627;&#x628;
                strong= user.role === 'admin'? "ادمن":"طالب"
            // إعادة تعيين كلمة المرور
            .password-box
              .info-icon.password-icon &#x1F512;
              .password-content
                span.label &#x643;&#x644;&#x645;&#x629; &#x627;&#x644;&#x645;&#x631;&#x648;&#x631;
                input.reset-password-input(type='text')
                button.reset-password-btn(type='button')
                  | &#x625;&#x639;&#x627;&#x62F;&#x629; &#x62A;&#x639;&#x64A;&#x64A;&#x646; &#x643;&#x644;&#x645;&#x629; &#x627;&#x644;&#x645;&#x631;&#x648;&#x631;
        section.card.color-card.section-1
          h2 &#x627;&#x644;&#x648;&#x636;&#x639; &#x627;&#x644;&#x645;&#x638;&#x644;&#x645;
          .color-row
            .toggle-wrap
              label.toggle
                input#dark-toggle(type='checkbox')
                span.slider
        // الكورسات
        section.card.courses-card.section-2.hidden
          h2 &#x627;&#x644;&#x643;&#x648;&#x631;&#x633;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x641;&#x639;&#x644;&#x629;
          .courses-grid
            each course in courses
              - const achievedCourse = courseSummaries.find(c => c.courseId.toString() == course._id.toString())
              - const percentage = Math.ceil((achievedCourse.achievedVideosCount/achievedCourse.totalVideos) * 100)
              article.course(data-course-id=course._id)
                .course-image.image-one
                 img.course-img(src=`/imgs/courses/${course.photoUrl}`)
                h3= course.title
                .progress-row
                  span &#x627;&#x644;&#x62A;&#x642;&#x62F;&#x645;
                  b= `${percentage}%`
                .progress
                  span(style=`width: ${percentage}%`)
                .course-footer
                  span= percentage > 0 && percentage < 50? "مبتدأ": percentage > 50 && percentage < 100 ? "متقدم" : "مكتمل"
                  button.enter-course-btn دخول الكورس
           
        // تفعيل الأكواد
        section.card.activation-card.section-3.hidden
          h2 &#x62A;&#x641;&#x639;&#x64A;&#x644; &#x627;&#x644;&#x623;&#x643;&#x648;&#x627;&#x62F;
          .activation-row
            input.activate-code-input(type='text' placeholder='أدخل الكود هنا')
            button.activate-code-btn(type='button') &#x62A;&#x641;&#x639;&#x64A;&#x644; &#x627;&#x644;&#x643;&#x648;&#x62F;
          .messages
            h3 &#x62C;&#x627;&#x646;&#x628; &#x645;&#x646; &#x627;&#x644;&#x646;&#x638;&#x627;&#x645;:
            ul
              li قم بنسخ الكود و لصقه هنا
              li تأكد من صحة الكود قبل التفعيل
  script(src='/js/settings.js')
