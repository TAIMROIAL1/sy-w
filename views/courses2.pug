                | &#x643;&#x648;&#x64A;&#x632; &#x627;&#x644;&#x645;&#x62D;&#x627;&#x636;&#x631;&#x629; &#x627;&#x644;&#x623;&#x648;&#x644;&#x649;
                button
                | &#x61F; &#x627;&#x62E;&#x62A;&#x628;&#x627;&#x631;
