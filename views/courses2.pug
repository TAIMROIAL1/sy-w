doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title كورس الباب الأول والثاني
  link(rel='preconnect' href='https://fonts.googleapis.com')
  link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
  link(href='https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap' rel='stylesheet')
  link(rel='stylesheet' href='/css/courses.css')

- const domain = process.env.DOMAIN_ACTIVE === 'local' ? process.env.DOMAIN_LOCAL : process.env.DOMAIN_RENDER;

body(data-domain=domain)

  // ================= HEADER =================
  header
    .logo
      span Studyou

    - if(!user)
      .auth-buttons
        button تسجيل الدخول

    - if(user)
      .balance= `${user.value} ATP`

    .dark-toggle
      label.toggle
        input#darkModeSwitch(type='checkbox')
        span.slider


  // ================= COURSE HEADER =================
  section.course-header
    .course-header-inner
      a.back-link(href=`${domain}/`) &larr; العودة
      h1= course.title
      p.start-date= `بداية نزول المحتوى ${course.startDate}`


  // ================= MAIN COURSE LAYOUT =================
  section.course-main
    .course-photo-block
      .photo-frame
        img.course-img(src=`/imgs/courses/${course.photoUrl}` alt=course.title)

      .price-row
        .course-price
          | #{course.price}
          span ATP

        p.lessons-label= `يشمل جميع دروس ${course.title}`

      .div-subscribe-btn
        a.subscribe-btn(href='#') اشترك الآن

    .course-about
      h2 عن الكورس
      p= course.description


  // ================= LESSONS SECTION =================
  .lessons-section
    h2 الدروس

    .lessons-scroll
      // الدرس الأول
      .course-lesson
        button.course-lesson-header(type='button')
          span
          span.lesson-index 01
            |                     &#x627;&#x644;&#x62F;&#x631;&#x633; &#x627;&#x644;&#x623;&#x648;&#x644;
            span.lesson-arrow &#x2304;
        .course-lesson-content
            ul.lesson-list
            li
                span.lesson-index 01
                span.lesson-name
                | &#x627;&#x644;&#x645;&#x62D;&#x627;&#x636;&#x631;&#x629; &#x627;&#x644;&#x623;&#x648;&#x644;&#x649;
                button
                | &#x25B6; &#x62A;&#x634;&#x63A;&#x63A;&#x64A;&#x644;
            li
                span.lesson-index 02
