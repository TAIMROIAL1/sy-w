  // ================= FOOTER =================
  footer
    .footer-logo
      span د/ إياد سكر

    .footer-links
      div
        h3 السوشيال ميديا
        ul
          li: a(href='https://www.facebook.com/share/1DvgbBYDmN/') فيسبوك
          li: a(href='https://www.instagram.com/dr.eyadsukar?igsh=M2Nya2NmdGg2bmZr') انستجرام
          li: a(href='#') تلجرام
          li: a(href='https://youtube.com/@iyadsukar_7979?si=q_7hit36Ic_K7xmC') يوتيوب

      div
        h3 الصفحات
        ul
          li: a(href=`${domain}/`) الرئيسية
          - if(user)
            li: a(href=`${domain}/settings`) الإعدادات
          - if(!user)
            li: a(href=`${domain}/sign-up`) التسجيل

    p.rights &copy; 2026 جميع الحقوق محفوظة

  script(src='/js/courses.js')
