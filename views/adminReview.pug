extends _layout
include _mixins

block content
  main.anki-page
    .container-narrow
      a.back-link(href='/anki')
        i.fa-solid.fa-arrow-right
        | العودة إلى البطاقات

      .page-hero.hero-community
        div
          h1 مراجعة المجموعات
          p مجموعات أرسلها الطلاب وتنتظر موافقتك قبل ظهورها في المجتمع
        span.btn.btn-light
          i.fa-solid.fa-hourglass-half
          |  #{groups.length} بانتظار المراجعة

      if groups.length
        .review-list
          each g in groups
            article.card-box.review-item(data-group-id=g._id)
              .review-head
                .group-avatar(style=`--hue:${hue(g.name)}`)= firstLetter(g.name)
                div
                  h3.group-name= g.name
                  .group-meta
                    span
                      i.fa-solid.fa-user
                      | #{g.owner ? g.owner.name : '—'}
                    span
                      i.fa-solid.fa-layer-group
                      | #{g.cardsCount} بطاقة
                    span
                      i.fa-regular.fa-clock
                      | #{timeAgo(g.submittedAt)}
              p.description= g.description
              .review-actions
                a.btn.btn-ghost(href=`/anki/groups/${g._id}/study`)
                  i.fa-solid.fa-eye
                  |  معاينة البطاقات
                button.btn.btn-success.approve-btn(type='button')
                  i.fa-solid.fa-check
                  |  موافقة ونشر
                button.btn.btn-danger-ghost.reject-btn(type='button')
                  i.fa-solid.fa-xmark
                  |  رفض
      else
        +emptyState('fa-shield-halved', 'لا توجد مجموعات بانتظار المراجعة', 'عندما يرسل الطلاب مجموعاتهم للنشر ستظهر هنا')

      //- new cards in published community groups (added or moved), hidden from other users until approved
      section.pending-cards-section
        h2.section-title
          i.fa-solid.fa-clone
          |  بطاقات جديدة في مجموعات منشورة
          span.count= pendingCount
        if pendingSections.length
          .review-list
            each section in pendingSections
              article.card-box.card-review(data-card-ids=section.cards.map(c => c._id).join(','))
                .review-head
                  .group-avatar(style=`--hue:${hue(section.group.name)}`)= firstLetter(section.group.name)
                  div
                    h3.group-name= section.path
                    .group-meta
                      span
                        i.fa-solid.fa-user
                        | #{section.group.owner ? section.group.owner.name : '—'}
                      span
                        i.fa-solid.fa-layer-group
                        | #{section.cards.length} بطاقة بانتظار الموافقة
                ul.card-list
                  each card in section.cards
                    li.card-item(data-card-id=card._id)
                      .card-item-body
                        +cardPreview(card)
                      .card-item-actions
                        button.icon-btn.approve-card-btn(type='button' title='موافقة' aria-label='الموافقة على البطاقة')
                          i.fa-solid.fa-check
                        button.icon-btn.danger.reject-card-btn(type='button' title='رفض' aria-label='رفض البطاقة')
                          i.fa-solid.fa-xmark
                .review-actions
                  button.btn.btn-success.approve-all-btn(type='button')
                    i.fa-solid.fa-check-double
                    |  موافقة على الكل
                  button.btn.btn-danger-ghost.reject-all-btn(type='button')
                    i.fa-solid.fa-xmark
                    |  رفض الكل
        else
          p.muted-note لا توجد بطاقات جديدة بانتظار الموافقة

block scripts
  script(src='/js/anki/adminReview.js')
