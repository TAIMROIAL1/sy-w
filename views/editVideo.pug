extends _adminForm

block vars
  - var pageTitle = 'تعديل فيديو'
  - var pageIcon = 'fa-play'
  - var pageSub = ''
  - var pageScript = 'editVideo'
  - var bodyData = {'data-subcourse-id': lesson.subcourse.toString(), 'data-lesson-id': lesson._id.toString(), 'data-video-num': video.num}

block form
    .container
      .form
        .field
          label(for='video-name') عنوان الفيديو
          input#video-name.input(type='text', value=video.title)
        .field
          label(for='video-sub-name') العنوان الفرعي
          input#video-sub-name.input(type='text', value=video.subtitle || '')
        .field
          label(for='video-url') رابط الفيديو
          input#video-url.input(type='text', value=video.videoUrl || '', dir='ltr')
        .field
          label(for='info') معلومات الفيديو
          input#info.input(type='text', value=video.info || '')
        .field
          label(for='duration') مدة الفيديو
          input#duration.input(type='text', value=video.duration || '', dir='ltr')
        .field
          label(for='num') ترتيب الفيديو في الدرس
          input#num.input(type='number', value=video.num, min='0')
        button.btn-sub(type='button') حفظ التعديلات
