extends _adminForm

mixin question(q)
  .question(data-question-id=q ? q._id.toString() : null)
    .question-header
      span.question-number السؤال
      button.remove-question-btn(type='button', aria-label='حذف السؤال')
        i.fa-solid.fa-xmark
    .field
      label نص السؤال
      input.input.question-text(type='text', value=q ? q.text : '')
    .answers-grid
      each n in [0, 1, 2, 3]
        .field
          label= `الإجابة ${n + 1}`
          input.input.answer-input(type='text', value=q ? q.answers[n] : '')
    .field
      label الإجابة الصحيحة (1-4)
      input.input.correct-answer(type='number', min='1', max='4', value=q ? q.correctAnswer + 1 : '')


block vars
  - var pageTitle = 'تعديل اختبار'
  - var pageIcon = 'fa-clipboard-question'
  - var pageSub = ''
  - var pageScript = 'editQuiz'
  - var bodyData = {'data-subcourse-id': lesson.subcourse.toString(), 'data-lesson-id': lesson._id.toString(), 'data-video-num': quiz.num}

block form
    .container
      .form
        .quiz-fields
          .field
            label(for='quiz-name') عنوان الاختبار
            input#quiz-name.input(type='text', value=quiz.title)
          .field
            label(for='num') ترتيب الاختبار في الدرس
            input#num.input(type='number', value=quiz.num, min='0')
          .questions
            each q in quiz.questions
              +question(q)
          button.add-question-btn(type='button')
            i.fa-solid.fa-plus
            |  أضف سؤال
        button.btn-sub(type='button') حفظ التعديلات

block extra
    //- template used by the JS to build a new question block
    template#question-template
      +question(null)
