extends _adminForm

block vars
  - var pageTitle = 'تعديل درس'
  - var pageIcon = 'fa-layer-group'
  - var pageSub = ''
  - var pageScript = 'editLesson'
  - var bodyData = {'data-subcourse-id': lesson.subcourse.toString(), 'data-lesson-id': lesson._id.toString()}

block form
    .container
      .form
        .field
          label(for='lesson-name') عنوان الدرس
          input#lesson-name.input(type='text', value=lesson.title)
        .field
          label(for='lesson-sub-name') عنوان فرعي
          input#lesson-sub-name.input(type='text', value=lesson.subtitle || '')
        .field
          label(for='num') رقم الدرس
          input#num.input(type='number', value=lesson.num, min='1')
        button.btn-sub(type='button') حفظ التعديلات
