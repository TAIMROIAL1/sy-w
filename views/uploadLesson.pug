extends _adminForm

block vars
  - var pageTitle = 'رفع درس'
  - var pageIcon = 'fa-layer-group'
  - var pageSub = 'أضف درسا جديدا للكورس'
  - var pageScript = 'uploadLesson'
  - var bodyData = {'data-lesson-num': lessonNum}

block form
    .container
      .form
        .field
          label(for='lesson-name') عنوان الدرس
          input#lesson-name.input(type='text')
        .field
          label(for='capital-name') عنوان الوحدة
          input#capital-name.input(type='text')
        .field
          label(for='num') رقم الدرس
          input#num.input(type='number')
        button.btn-sub(type='button') رفع
