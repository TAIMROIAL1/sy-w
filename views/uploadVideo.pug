doctype html
html(lang='ar', dir='rtl')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css")
    link(href='https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap' rel='stylesheet')
    link(rel='stylesheet', href='/css/uploadResource.css')
    link(rel='icon', type='image/svg+xml', href='/my-favicon/favicon.svg?v=20260916')
    title رفع محتوى
  - const domain = process.env.DOMAIN_ACTIVE === 'local'? process.env.DOMAIN_LOCAL : process.env.DOMAIN_RENDER;
  body(data-domain = `${domain}`)
    .c
      .correct.hidden
        .correct-message

    main.upload-shell
      a.back-link#backLink(href='#')
        i.fa-solid.fa-arrow-right
        | العودة للدروس

      .upload-card
        .upload-head
          .upload-icon
            i.fa-solid.fa-cloud-arrow-up
          h1.upload-class رفع فيديو
          p.upload-sub اختر نوع المحتوى ثم املأ البيانات

        .form
          .file-type.btns-container
            button.file-type-btn.video-res.active(type='button')
              i.fa-solid.fa-play
              span فيديو
            button.file-type-btn.quiz-res(type='button')
              i.fa-solid.fa-clipboard-question
              span اختبار
            button.file-type-btn.file-res(type='button')
              i.fa-solid.fa-file-arrow-down
              span ملف

          .video-fields
            .field
              label(for='video-name') عنوان الفيديو
              input#video-name.input(type='text')
            .field
              label(for='video-sub-name') العنوان الفرعي
              input#video-sub-name.input(type='text')
            .field
              label(for='video-url') رابط الفيديو
              input#video-url.input(type='text', dir='ltr')
            .field
              label(for='info') معلومات الفيديو
              input#info.input(type='text')
            .field
              label(for='duration') مدة الفيديو
              input#duration.input(type='text', dir='ltr', placeholder='12:30')

          .file-fields.hidden
            .field
              label(for='file-name') عنوان الملف
              input#file-name.input(type='text')
            .field
              label(for='file-info') وصف الملف (اختياري)
              input#file-info.input(type='text')
            .field
              span.field-label الملف
              label.file-picker(for='lesson-file')
                span.file-picker-icon
                  i.fa-solid.fa-paperclip
                span.file-picker-text
                  strong#fileChosen اختر ملف
                  small#fileChosenSize اضغط لاختيار ملف من جهازك
              input#lesson-file.file-input(type='file')

          .quiz-fields.hidden
            .field
              label(for='quiz-name') عنوان الاختبار
              input#quiz-name.input(type='text')
            .questions
            button.add-question-btn(type='button')
              i.fa-solid.fa-plus
              | أضف سؤال

          button.btn-sub(type='button') رفع

    //- template used by the JS to build one question block
    template#question-template
      .question
        .question-header
          span.question-number السؤال
          button.remove-question-btn(type='button', aria-label='حذف السؤال')
            i.fa-solid.fa-xmark
        .field
          label نص السؤال
          input.input.question-text(type='text')
        .answers-grid
          .field
            label الإجابة 1
            input.input.answer-input(type='text')
          .field
            label الإجابة 2
            input.input.answer-input(type='text')
          .field
            label الإجابة 3
            input.input.answer-input(type='text')
          .field
            label الإجابة 4
            input.input.answer-input(type='text')
        .field
          label الإجابة الصحيحة (1-4)
          input.input.correct-answer(type='number', min='1', max='4')

    script(defer, src='/js/uploadVideo.js')
