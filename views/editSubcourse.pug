extends _adminForm

block vars
  - var pageTitle = 'تعديل الكورس'
  - var pageIcon = 'fa-book-open'
  - var pageSub = ''
  - var pageScript = 'editSubcourse'
  - var bodyData = {}

block form
    .container
      .form
        .field
          label(for='subcourse-name') اسم الكورس
          input#subcourse-name.input(type='text', value=cToEdit.title || '')
        .field
          label(for='subcourse-des') الوصف
          input#subcourse-des.input(type='text', value=cToEdit.description || '')
        .field
          label(for='image') رابط الصورة
          input#image.input(type='text', value=cToEdit.photoUrl || '', dir='ltr')
        .field
          label(for='price') السعر
          input#price.input(type='number', value=cToEdit.price || '')
        label.check-row(for='coming-soon')
          input#coming-soon(type='checkbox', checked=!!cToEdit.comingSoon)
          span قريبا (يظهر في الصفحة الرئيسية بدون إمكانية الشراء)
        label.check-row(for='course-finished')
          input#course-finished(type='checkbox', checked=!!cToEdit.finished)
          span الكورس مكتمل (لن تضاف دروس جديدة)
        button.btn-sub(type='button') حفظ التعديلات
