extends _adminForm

block vars
  - var pageTitle = 'تعديل صف'
  - var pageIcon = 'fa-school'
  - var pageSub = ''
  - var pageScript = 'editClass'
  - var bodyData = {}

block form
    .container
      .form
        .field
          label(for='class-name') اسم الصف
          input#class-name.input(type='text', value=cToEdit.title)
        .field
          label(for='class-des') الوصف
          input#class-des.input(type='text', value=cToEdit.description)
        .field
          label(for='image') رابط الصورة
          input#image.input(type='text', value=cToEdit.photoUrl, dir='ltr')
        button.btn-sub(type='button') حفظ التعديلات
