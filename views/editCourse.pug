extends _adminForm

block vars
  - var pageTitle = 'تعديل كورس'
  - var pageIcon = 'fa-book-open'
  - var pageSub = ''
  - var pageScript = 'editCourse'
  - var bodyData = {}

block form
    .container
      .form
        .field
          label(for='course-name') اسم الكورس
          input#course-name.input(type='text', value=cToEdit.title)
        .field
          label(for='course-des') الوصف
          textarea#course-des.input(rows='4')= cToEdit.description
        .field
          label(for='image') رابط الصورة
          input#image.input(type='text', value=cToEdit.photoUrl, dir='ltr')
        .field
          label(for='price') السعر
          input#price.input(type='number', value=cToEdit.price)
        button.btn-sub(type='button') حفظ التعديلات
