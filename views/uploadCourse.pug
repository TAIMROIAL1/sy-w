extends _adminForm

block vars
  - var pageTitle = 'رفع كورس'
  - var pageIcon = 'fa-book-open'
  - var pageSub = 'أضف كورسا جديدا'
  - var pageScript = 'uploadCourse'
  - var bodyData = {}

block form
    .container
      .form
        .field
          label(for='class-name') اسم الكورس
          input#class-name.input(type='text')
        .field
          label(for='class-des') الوصف
          textarea#class-des.input(rows='4')
        .field
          label(for='image') رابط الصورة
          input#image.input(type='text', dir='ltr')
        .field
          label(for='num') السعر
          input#num.input(type='number')
        .field
          label(for='time') موعد نشر الكورس
          input#time.input(type='text')
        button.btn-sub(type='button') رفع
